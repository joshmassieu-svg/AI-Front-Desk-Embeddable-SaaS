# Google Gemini API Key for RAG & Streaming Chat Generation
GEMINI_API_KEY=your_gemini_api_key_here

# Public deployment origin URL on Vercel
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# HubSpot CRM — Legacy App / Private App access token (server-side only, keep secret)
# Scopes: crm.objects.contacts.read, crm.objects.contacts.write, crm.schemas.contacts.write
HUBSPOT_ACCESS_TOKEN=your_hubspot_access_token_here

# ──────────────────────────────────────────────
# Stripe — Payments & Subscriptions
# ──────────────────────────────────────────────

# Your Stripe secret key (never expose this to the browser)
STRIPE_SECRET_KEY=sk_live_...

# Your Stripe publishable key (safe for the browser — not currently used server-side but good to have)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Webhook signing secret — get this from the Stripe dashboard after adding the endpoint
# Endpoint URL: https://your-app.vercel.app/api/stripe/webhook
# Events to listen for:
#   checkout.session.completed
#   customer.subscription.updated
#   customer.subscription.deleted
#   invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — create these in the Stripe dashboard (Products > Prices)
# One Price ID per plan × billing cycle combination

STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...

STRIPE_PRICE_GROWTH_MONTHLY=price_...
STRIPE_PRICE_GROWTH_ANNUAL=price_...

STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
